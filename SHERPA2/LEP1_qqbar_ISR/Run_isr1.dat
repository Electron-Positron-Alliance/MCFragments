(run){
  % Sherpa 2.2.6 runcard for e+e- -> Z -> hadrons at LEP1 (91.188 GeV)
  % ISR ON: BUNCH_1/2 enables lepton bunch functions -> QED ISR active

  EVENTS 500000;

  ALPHAS(MZ) 0.1188;

  BEAM_1  11; BEAM_ENERGY_1 45.594;
  BEAM_2 -11; BEAM_ENERGY_2 45.594;
  BUNCH_1  11; BUNCH_2 -11;

  EVENT_OUTPUT HepMC_GenEvent[events];
}(run)

(processes){
  Process 11 -11 -> 93 93;
  Order (*,2);
  End process;
}(processes)
