 build_gfortran.sh             |   9 +-
 korale-exp-final/lib/photos.f |   2 +-
 13 files changed, 679 insertions(+), 738 deletions(-)

diff --git a/ProdRun/MainKoralzHepMC.f b/ProdRun/MainKoralzHepMC.f
index 4248bcd..7b9a801 100644
--- a/ProdRun/MainKoralzHepMC.f
+++ b/ProdRun/MainKoralzHepMC.f
@@ -27,7 +27,10 @@ C KKMCee constituent quark masses d,u,s,c,b (xpar 516..556; d,u "for comparison
       READ(ARG,*) ISEED
       IF (KFQ.LT.1.OR.KFQ.GT.5) STOP 'PDGQ must be 1..5'
       IF (ISR.NE.0.AND.ISR.NE.1) STOP 'ISR must be 0 or 1'
+C TAUOLA RANMAR and YFS3 MARRAN share /RASET1/; MARRAN would re-seed it to 54217137 on its
+C first call (YFS3, ISR on) unless MARINI is called first. Seed both.
       CALL RMARIN(ISEED,0,0)
+      CALL MARINI(ISEED,0,0)
       DO I=1,40
         XPR(I)=0
         NPR(I)=0
